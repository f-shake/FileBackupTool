{
  // =========================================================================
  // FileBackupTool · 生产环境配置（appsettings.Production.json）
  //
  // 这份文件由 install-service.ps1 从 appsettings.Production.json.template 生成，
  // 生成之后它就是这个**生产机上的事实来源**——重新发布、重跑安装脚本都不会覆盖它。
  //
  // 只写需要覆盖 appsettings.json 默认值的项，没写的项沿用 appsettings.json。
  // （应用启动时 ASPNETCORE_ENVIRONMENT=Production，所以本文件会被自动加载并覆盖。）
  //
  // ⚠ 任何密钥都**不得**写进本文件（设计文档 05 §7）：
  //   初始账号密码只能来自环境变量 FILEBACKUPTOOL_ADMIN_PASSWORD。
  //   本文件会被复制、会被"帮我看一下"的人看到。
  // =========================================================================

  // 数据目录：SQLite 数据库、日志、DataProtection 密钥环、单实例锁文件都在这里。
  //
  // **必须是绝对路径**（设计文档 01 §7.3）：注册成 Windows 服务后工作目录与
  // 双击运行不同，相对路径会被解析到别处——数据就写到了意想不到的地方。
  //
  // 这个目录**不要**放在程序目录里，也不要放在任何备份源目录之内：
  // 前者会让重新发布覆盖程序目录时连带丢数据，后者会让备份把备份自己再备份一遍。
  "DataDir": "__DATA_DIR__",

  "Kestrel": {
    // 只监听本机，对外由 nginx 终止 TLS（设计文档 01 §7.2）。
    // 这个形态是经过验证的；想直接暴露到公网请自行提供证书，但那不在本项目验证范围内。
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:__PORT__"
      }
    }
  },

  "ReverseProxy": {
    // ⚠ 必须只填 **nginx 的地址**（设计文档 05 §6.1 ②）。
    //
    // X-Forwarded-For 是客户端可以自己伪造的头。信任所有来源的后果不是"少一层防护"，
    // 而是**登录限流彻底失效**：所有人共用同一份配额——既挡不住暴力破解，
    // 又会因为别人乱试而把自己锁在外面。
    //
    // nginx 与本程序同机时保持 127.0.0.1 / ::1 即可；nginx 在别的机器上就换成它的 IP。
    // 注意这里只认 IP，写主机名会被忽略（启动日志里会有 Warning）。
    "TrustedProxies": [ "127.0.0.1", "::1" ],

    // HSTS 由应用下发，nginx 侧透传（设计文档 05 §6.1 ④）。
    // 应用**没有**启用 UseHttpsRedirection——反代之后应用看到的 scheme 是 http，
    // 无条件重定向会死循环（05 §6.1 ③ 的第二种做法）。所以 http→https 的跳转
    // 要在 nginx 侧做，见 nginx.conf.sample。
    "UseHsts": true,
    "HstsMaxAgeDays": 365
  },

  "Security": {
    // 还原根白名单的**初始值**。
    //
    // 只在**首次启动、数据库为空**时用它播种；之后运行时以数据库里的值为准，
    // 改这个文件对已经跑过的实例没有影响（要改请在界面里改）。
    //
    // 还原是"往服务器上写文件"的操作，白名单是最重要的安全缓解（设计文档 04 §1.3）。
    // 保持空列表 = 谁都还原不了，界面上也没有根可选。首次登录后请务必配置。
    //
    // 写法示例（JSON 里反斜杠要写两个）：
    //   "AllowedRestoreRoots": [ "D:\\Restore", "E:\\恢复" ]
    "AllowedRestoreRoots": []
  },

  "Serilog": {
    // Trace / Debug / Information / Warning / Error / Fatal
    "MinimumLevel": "Information"
  }
}
