{
  // =========================================================================
  // FileBackupTool · 基础设施配置（启动期）
  //
  // 结构对照：设计文档 01 §5.1。
  // 只放**基础设施**：连接串、数据目录、日志级别、信任代理、限流参数、Cookie 策略。
  // 业务数据（任务定义、还原根白名单、保留策略）在数据库里，见 01 §5.2 与 06 §4.9。
  //
  // 说明：JsonConfigurationProvider 允许注释与尾随逗号（CommentHandling=Skip），
  //      所以下面的中文注释是安全的，不会被解析器拒绝。
  //
  // ⚠ 任何密钥都**不得**写进本文件（设计文档 05 §7）。
  //   初始账号密码只能通过环境变量提供，见 Security.SeedPasswordEnvironmentVariable。
  //   本文件将来会被提交到仓库。
  // =========================================================================

  "DataDir": "App_Data",

  "ConnectionStrings": {
    // 仅作为占位/参考：实际连接串由 DataDir 推导（App_Data/filebackuptool.db）。
    // 之所以不直接采信这里的值，是为了避免"数据目录"出现两个互相矛盾的事实来源。
    "Default": "Data Source=App_Data/filebackuptool.db"
  },

  "Serilog": {
    // Trace / Debug / Information / Warning / Error / Fatal
    "MinimumLevel": "Information"
  },

  "Kestrel": {
    // 设计文档 01 §7.2 / 05 §6：nginx 终止 TLS，Kestrel 只监听 localhost。
    // 直接暴露到公网时请改 Endpoints 配置并自行提供证书。
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },

  "ReverseProxy": {
    // 设计文档 05 §6.1 ②：只有这些 IP 写入的 X-Forwarded-* 才被采信。
    // X-Forwarded-For 可被客户端伪造，信任所有来源等于登录限流形同虚设
    //（所有人共用一份配额：既挡不住攻击，又误伤自己）。
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    // HSTS 由应用设置，nginx 侧透传（设计文档 05 §6.1 ④）。
    "UseHsts": true,
    "HstsMaxAgeDays": 365
  },

  "Security": {
    // 强制 TOTP：未绑定前不能访问任何业务功能（设计文档 05 §2.2）。
    "RequireConfirmedTwoFactor": true,

    // 会话：滑动 7 天 + 绝对 30 天（设计文档 05 §3）。
    "CookieSlidingDays": 7,
    "CookieAbsoluteDays": 30,

    "LoginRateLimit": { "PermitLimit": 5, "WindowMinutes": 5 },
    "Lockout": { "MaxFailedAttempts": 5, "Minutes": 15 },

    // 全局 API 限流（按认证状态分别配额，设计文档 05 §4）。
    "ApiRateLimit": { "AuthenticatedPerMinute": 600, "AnonymousPerMinute": 60 },
    // 写入/重型接口更严格。
    "WriteRateLimit": { "PermitLimit": 30, "WindowSeconds": 60 },

    // 创建时自动执行 EF migrations（禁用 EnsureCreated，设计文档决策 #7）。
    "AutoMigrate": true,

    // 初始账号：用户名在这里，**密码只能来自环境变量**。
    "SeedUserName": "admin",
    "SeedPasswordEnvironmentVariable": "FILEBACKUPTOOL_ADMIN_PASSWORD",

    // 还原根白名单的**初始值**。运行时以数据库中的 Security.AllowedRestoreRoots 为准
    //（首次启动时若数据库为空，用这里的值播种）。设计文档 04 §1.3 的硬约束。
    "AllowedRestoreRoots": [],

    // 完整校验默认不重算哈希（TB 级极慢，设计文档 08 §4.2）。
    "VerifyDeepHashByDefault": false
  },

  "Jobs": {
    // 固定为 1。设计文档 01 §4.1：源与目标都在机械硬盘上，并发只会因寻道抖动互相拖慢。
    "GlobalConcurrency": 1,
    "DbBatchSize": 2000,
    "FailureRatioThreshold": 0.10,
    "ConsecutiveFailureThreshold": 100,
    "IoRetryCount": 3,
    "IoRetryBaseDelaySeconds": 0.5
  },

  "Monitoring": {
    "FullScanFallbackHours": 6,
    "SettleWindowSeconds": 10,
    "CoalesceWindowSeconds": 45,
    "LocalScanDebounceSeconds": 5,
    "NetworkPollIntervalMinutes": 3,
    "LocalScanDegradeRatio": 0.30,
    "EventQueueCapacity": 10000,
    "QueueBackpressureThreshold": 1
  },

  "Scheduler": {
    // 调度节拍。设计文档 06 §8：SchedulerService 每 60 秒检查一次任务是否到期。
    "TickSeconds": 60
  },

  "Retention": {
    // **默认关闭**。自动删除用户的备份历史是不可逆的惊喜，不该是默认行为（设计文档 04 §2.3）。
    // 运行时以数据库中的 Retention.AutoEvictionEnabled 为准；
    // 这里的值只在数据库为空时作为播种值。开启需要二次确认（UI 侧语义）。
    "AutoEvictionEnabled": false,
    "MaxSnapshotGroups": 10,
    "MaxAgeDays": 180,
    "MaxTotalBytesGb": 0,
    "TickMinutes": 60
  },

  "Storage": {
    "ManifestShardThreshold": 10000,
    "ManifestShardMaxEntries": 20000
    // DataDirectory 由 DataDir 推导后注入，不要在这里写（避免两个事实来源）。
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*"
}
