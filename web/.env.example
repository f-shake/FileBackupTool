# 复制为 web/.env.local 后按需修改。所有变量都必须以 VITE_ 开头才会注入前端。

# 是否启用 Mock 层（无后端时用于演示）。默认关闭。
# 取值：true / false
VITE_USE_MOCK=false

# REST 基础路径。默认 /api（由 Vite 代理到 http://localhost:5000）
VITE_API_BASE=/api

# SignalR Hub 路径。默认 /hubs/events
VITE_HUB_PATH=/hubs/events

# REST 轮询间隔（毫秒）。SignalR 连续 3 次重连失败后启用。默认 5000
VITE_POLL_INTERVAL_MS=5000
